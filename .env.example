# Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:5173","localhost:5173","http://127.0.0.1:5173"]

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=chatbot
KEYCLOAK_CLIENT_ID=chatbot-frontend
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak (frontend)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=chatbot
VITE_KEYCLOAK_CLIENT_ID=chatbot-frontend

# MongoDB
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
MONGO_USERNAME=admin
MONGO_PASSWORD=admin
MONGO_DB=app_database

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=chunks

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# File uploads
UPLOAD_DIR=./uploads
